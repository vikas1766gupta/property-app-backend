NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/property_app?schema=public"

JWT_SECRET="change-me-to-a-long-random-string"

STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

CORS_ORIGIN="http://localhost:4200"

# Email delivery queue and SMTP worker. Keep credentials out of source control.
REDIS_URL="redis://127.0.0.1:6379"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Property App <noreply@example.com>"
DEFAULT_BUSINESS_PLAN=""

LOG_LEVEL=debug

# Cloudinary storage for business property images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Non-production seed credentials. Never set these in production.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_BROKER_EMAIL=broker@example.test
SEED_BROKER_PASSWORD=
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=
SEED_BUILDER_EMAIL=builder@example.test
SEED_BUILDER_PASSWORD=
